---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: '{{ ansible_operator_meta.name }}-web'
  namespace: '{{ ansible_operator_meta.namespace }}'
  labels:
    {{ lookup("template", "../common/templates/labels/common.yaml.j2") | indent(4) | trim }}
    app.kubernetes.io/component: webserver
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: 'nginx'
      app.kubernetes.io/instance: 'nginx-{{ ansible_operator_meta.name }}'
      app.kubernetes.io/component: webserver
  policyTypes:
    - Ingress
    - Egress
  ingress:
    # Allow traffic from the OpenShift router (Routes) and ingress controllers.
    - from:
        - namespaceSelector:
            matchLabels:
              policy-group.network.openshift.io/ingress: ""
        - namespaceSelector:
            matchLabels:
              network.openshift.io/policy-group: ingress
      ports:
        - protocol: TCP
          port: 8080
    # Allow traffic from the gateway (reverse proxy) and other Hub/AAP pods.
    # aap-operator is the managed-by label carried by the gateway pod in a
    # full AAP deployment (not aap-gateway-operator). namespaceSelector:
    # {} + podSelector (same list item = AND) allows the operator pod to
    # reach the Hub API when it runs in a separate namespace.
    - from:
        - podSelector:
            matchExpressions:
              - key: app.kubernetes.io/managed-by
                operator: In
                values:
                  - '{{ deployment_type }}-operator'
                  - 'aap-operator'
        - namespaceSelector: {}
          podSelector:
            matchLabels:
              control-plane: controller-manager
      ports:
        - protocol: TCP
          port: 8080
  egress:
    # Allow DNS resolution via OpenShift DNS
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: openshift-dns
      ports:
        - protocol: TCP
          port: 5353
        - protocol: UDP
          port: 5353
    # Allow egress to the Hub API pod (web proxies API requests to the api pod)
    - to:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: '{{ deployment_type }}-api'
              app.kubernetes.io/instance: '{{ deployment_type }}-api-{{ ansible_operator_meta.name }}'
              app.kubernetes.io/component: api
      ports:
        - protocol: TCP
          port: 8000
    # Allow egress to the Hub content pod (web proxies content downloads)
    - to:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: '{{ deployment_type }}-content'
              app.kubernetes.io/instance: '{{ deployment_type }}-content-{{ ansible_operator_meta.name }}'
              app.kubernetes.io/component: content-server
      ports:
        - protocol: TCP
          port: 24816
